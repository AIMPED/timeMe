# Copy to .env and fill in before the first `docker compose up`.

# Signs session cookies. Generate one with:  openssl rand -hex 32
# Changing it signs everybody out.
TIMEME_SECRET_KEY=CHANGE_ME

# Every day boundary in the app is drawn in this zone.
TIMEME_TIMEZONE=Europe/Berlin

# Nominal minutes per workday for users created without an explicit value.
TIMEME_DEFAULT_NOMINAL_MINUTES=420

# Session lifetime in hours (336 = 14 days).
TIMEME_SESSION_HOURS=336

# Keep true behind HTTPS. Only set false for local HTTP testing.
TIMEME_COOKIE_SECURE=true

# Host port Caddy proxies to. Bound to 127.0.0.1 only.
TIMEME_BIND_PORT=8787

# Nightly backup time (HH:MM, in TIMEME_TIMEZONE) and retention in days.
BACKUP_AT=03:30
BACKUP_KEEP_DAYS=30
